---
import { WHATSAPP_NUMBER } from '../lib/contact';

const slides = [
  {
    img: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?q=80&w=1920&auto=format&fit=crop',
    alt: 'Familia protegida con un seguro de vida y salud',
    kicker: 'Personas y familia',
    titulo: 'Protege a tu familia y tu futuro',
    texto: 'Vida, salud, accidentes y deuda con asesoría clara y humana, desde San Miguel para todo El Salvador.',
  },
  {
    img: 'https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&w=1920&auto=format&fit=crop',
    alt: 'Vehículo circulando por carretera',
    kicker: 'Vehículos y hogar',
    titulo: 'Tu auto y tu casa, siempre respaldados',
    texto: 'Cobertura contra accidentes, robo, incendio y desastres, con asistencia y reclamos acompañados.',
  },
  {
    img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=1920&auto=format&fit=crop',
    alt: 'Edificio corporativo de una empresa',
    kicker: 'Empresas y fianzas',
    titulo: 'Tu negocio operando sin pausas',
    texto: 'Activos, responsabilidad civil, transporte y fianzas para proyectos y licitaciones.',
  },
];

const waBase = `https://wa.me/${WHATSAPP_NUMBER}`;
---
<section id="inicio" class="relative flex min-h-[100svh] items-end overflow-hidden bg-abismo-950 pb-16 pt-32 lg:items-center">
  <!-- Carrusel de fondo -->
  <div class="absolute inset-0" role="region" aria-label="Carrusel destacado">
    {slides.map((s, i) => (
      <div class={`hero-slide absolute inset-0 ${i === 0 ? 'activo' : ''}`} data-slide={i}>
        <img src={s.img} alt={s.alt} class="h-full w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
    <div class="absolute inset-0 bg-gradient-to-r from-abismo-950/95 via-abismo-950/70 to-abismo-950/25"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-abismo-950 to-transparent"></div>
  </div>

  <div class="relative mx-auto grid w-full max-w-7xl gap-10 px-5 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:px-8">
    <div>
      <p class="eyebrow mb-4 inline-flex items-center gap-2 rounded-full border border-cielo-400/40 bg-white/5 px-4 py-2 text-cielo-300 backdrop-blur">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        San Miguel · Zona oriental · Todo El Salvador
      </p>
      <div id="hero-copy" class="min-h-[240px]">
        {slides.map((s, i) => (
          <div class={`hero-copy ${i === 0 ? '' : 'hidden'}`} data-copy={i}>
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.3em] text-latón-400">{s.kicker}</p>
            <h1 class="font-display text-4xl leading-[1.05] text-white sm:text-5xl lg:text-6xl">{s.titulo}</h1>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">{s.texto}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#cotizar" class="rounded-full bg-cielo-500 px-7 py-3.5 text-sm font-bold text-abismo-950 shadow-xl transition hover:bg-cielo-300">
          Solicitar cotización
        </a>
        <a href={`${waBase}?text=${encodeURIComponent('Hola Adapto Seguros, quiero hablar con un asesor.')}`} target="_blank" rel="noopener" class="rounded-full border border-white/30 px-7 py-3.5 text-sm font-bold text-white backdrop-blur transition hover:border-cielo-300 hover:text-cielo-300">
          Hablar con un asesor
        </a>
      </div>
      <!-- Controles carrusel -->
      <div class="mt-8 flex items-center gap-4">
        <button id="hero-prev" aria-label="Anterior" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-cielo-300 hover:text-cielo-300">‹</button>
        <button id="hero-next" aria-label="Siguiente" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white transition hover:border-cielo-300 hover:text-cielo-300">›</button>
        <div class="flex gap-2" role="tablist" aria-label="Diapositivas">
          {slides.map((_, i) => (
            <button class="hero-dot h-2 rounded-full transition-all" data-dot={i} aria-label={`Ir a diapositiva ${i + 1}`}></button>
          ))}
        </div>
      </div>
    </div>

    <!-- Tarjeta vidrio: cotización exprés -->
    <aside class="rounded-3xl border border-white/15 bg-white/10 p-6 shadow-2xl backdrop-blur-xl lg:p-8">
      <p class="eyebrow text-cielo-300">Cotización exprés</p>
      <h2 class="font-display mt-2 text-2xl text-white">Arma tu solicitud en 20 segundos</h2>
      <label class="mt-5 block text-xs font-bold uppercase tracking-widest text-white/70" for="hero-tipo">¿Qué quieres proteger?</label>
      <select id="hero-tipo" class="mt-2 w-full rounded-xl border border-white/15 bg-abismo-950/70 px-4 py-3 text-sm font-semibold text-white">
        <option>Seguro de salud</option>
        <option>Seguro de vida</option>
        <option>Seguro de vehículo</option>
        <option>Seguro de vivienda</option>
        <option>Seguro para negocio</option>
        <option>Fianza</option>
      </select>
      <label class="mt-4 block text-xs font-bold uppercase tracking-widest text-white/70" for="hero-nombre">Tu nombre</label>
      <input id="hero-nombre" type="text" placeholder="Ej. María González" class="mt-2 w-full rounded-xl border border-white/15 bg-abismo-950/70 px-4 py-3 text-sm text-white placeholder:text-white/40" />
      <a id="hero-wa" href={`${waBase}?text=${encodeURIComponent('Hola Adapto Seguros, quiero cotizar un Seguro de salud.')}`} target="_blank" rel="noopener" class="mt-5 flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-emerald-400">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.4.5c-.1.2-.3.3-.1.6.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.8 1.8.3.2.5.1.7-.1l.9-1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.7 1.8Z"/></svg>
        Enviar por WhatsApp
      </a>
      <p class="mt-3 text-center text-xs text-white/60">Respuesta en horario hábil · Sin compromiso</p>
    </aside>
  </div>
</section>

<script define:vars={{ waBase }}>
  const slidesEls = [...document.querySelectorAll('[data-slide]')];
  const copyEls = [...document.querySelectorAll('[data-copy]')];
  const dots = [...document.querySelectorAll('[data-dot]')];
  let actual = 0;
  let timer;

  function pintar(i) {
    actual = (i + slidesEls.length) % slidesEls.length;
    slidesEls.forEach((el, k) => el.classList.toggle('activo', k === actual));
    copyEls.forEach((el, k) => el.classList.toggle('hidden', k !== actual));
    dots.forEach((el, k) => {
      el.style.width = k === actual ? '2rem' : '0.6rem';
      el.style.background = k === actual ? '#8fbdd6' : 'rgba(255,255,255,.35)';
    });
  }
  function auto() {
    clearInterval(timer);
    timer = setInterval(() => pintar(actual + 1), 6000);
  }
  document.getElementById('hero-prev')?.addEventListener('click', () => { pintar(actual - 1); auto(); });
  document.getElementById('hero-next')?.addEventListener('click', () => { pintar(actual + 1); auto(); });
  dots.forEach((d) => d.addEventListener('click', () => { pintar(Number(d.dataset.dot)); auto(); }));
  pintar(0);
  auto();

  const tipo = document.getElementById('hero-tipo');
  const nombre = document.getElementById('hero-nombre');
  const wa = document.getElementById('hero-wa');
  function actualizarHero() {
    const t = tipo?.value ?? 'un seguro';
    const n = nombre?.value?.trim();
    const msg = `Hola Adapto Seguros, ${n ? `soy ${n} y ` : ''}quiero cotizar ${t}.`;
    wa?.setAttribute('href', `${waBase}?text=${encodeURIComponent(msg)}`);
  }
  tipo?.addEventListener('change', actualizarHero);
  nombre?.addEventListener('input', actualizarHero);
</script>
