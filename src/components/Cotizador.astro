---
import { WHATSAPP_NUMBER } from '../lib/contact';

const categorias = [
  { id: 'personas', label: 'Personas y familia', opciones: ['Seguro de salud', 'Seguro de vida', 'Seguro de accidentes', 'Seguro de deuda'] },
  { id: 'hogar', label: 'Vehículos y hogar', opciones: ['Seguro de vehículo', 'Seguro de vivienda', 'Robo y hurto', 'Seguro de daños'] },
  { id: 'empresas', label: 'Empresas', opciones: ['Seguro para negocios', 'Responsabilidad civil', 'Transporte de mercancía', 'Pérdida de utilidades'] },
  { id: 'fianzas', label: 'Fianzas', opciones: ['Fianza de oferta', 'Fianza de fiel cumplimiento', 'Fianza de anticipo', 'Garantía contractual'] },
];
const prioridades = ['Quiero cotizar esta semana', 'Estoy comparando opciones', 'Necesito revisar mi póliza actual', 'Es para una renovación próxima'];
---
<section id="cotizar" class="bg-marfil-100 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="revelar mx-auto max-w-2xl text-center">
      <p class="eyebrow text-abismo-600">Solicitud guiada</p>
      <h2 class="font-display mt-3 text-3xl text-abismo-950 sm:text-4xl lg:text-5xl">Cuéntanos qué quieres proteger</h2>
      <p class="mt-4 text-slate-600"><strong class="text-abismo-800">1.</strong> Elige categoría · <strong class="text-abismo-800">2.</strong> Selecciona cobertura · <strong class="text-abismo-800">3.</strong> Envía por WhatsApp</p>
    </div>

    <div class="revelar mx-auto mt-10 max-w-4xl rounded-[2rem] bg-abismo-950 p-6 shadow-2xl sm:p-10">
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Categorías">
        {categorias.map((c, i) => (
          <button class="cat-tab rounded-full px-5 py-2.5 text-sm font-bold transition" data-cat={c.id} data-activo={i === 0 ? 'si' : 'no'} role="tab">{c.label}</button>
        ))}
      </div>

      {categorias.map((c, i) => (
        <div class={`cat-panel mt-6 ${i === 0 ? '' : 'hidden'}`} data-panel={c.id}>
          <p class="text-xs font-bold uppercase tracking-widest text-white/60">Selecciona cobertura</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {c.opciones.map((o, j) => (
              <button class={`opcion rounded-full border px-4 py-2 text-sm font-semibold transition ${j === 0 ? 'border-cielo-400 bg-cielo-500/20 text-white' : 'border-white/15 text-white/75 hover:border-cielo-400/60'}`} data-opcion={o}>{o}</button>
            ))}
          </div>
        </div>
      ))}

      <div class="mt-6">
        <p class="text-xs font-bold uppercase tracking-widest text-white/60">Prioridad</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {prioridades.map((p, j) => (
            <button class={`prioridad rounded-full border px-4 py-2 text-sm transition ${j === 0 ? 'border-latón-400 bg-latón-500/20 text-white' : 'border-white/15 text-white/75 hover:border-latón-400/60'}`} data-prioridad={p}>{p}</button>
          ))}
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-white/60">Resumen de solicitud</p>
        <p id="cot-resumen" class="font-display mt-2 text-xl text-white">Seguro de salud · Quiero cotizar esta semana</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a id="cot-wa" href="#" target="_blank" rel="noopener" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-500 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-emerald-400">
            Enviar solicitud por WhatsApp
          </a>
          <a href="#contacto" class="flex flex-1 items-center justify-center rounded-xl border border-white/25 px-6 py-3.5 text-sm font-bold text-white transition hover:border-cielo-300 hover:text-cielo-300">
            Prefiero llamar
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ numero: WHATSAPP_NUMBER }}>
  let cobertura = 'Seguro de salud';
  let prioridad = 'Quiero cotizar esta semana';
  const resumen = document.getElementById('cot-resumen');
  const enlace = document.getElementById('cot-wa');
  const tabs = [...document.querySelectorAll('.cat-tab')];
  const panels = [...document.querySelectorAll('.cat-panel')];

  function pintarTabs() {
    tabs.forEach((t) => {
      const on = t.dataset.activo === 'si';
      t.className = `cat-tab rounded-full px-5 py-2.5 text-sm font-bold transition ${on ? 'bg-cielo-500 text-abismo-950' : 'bg-white/10 text-white/75 hover:bg-white/20'}`;
    });
  }
  function actualizar() {
    if (resumen) resumen.textContent = `${cobertura} · ${prioridad}`;
    const msg = `Hola Adapto Seguros, quiero solicitar: ${cobertura}. ${prioridad}.`;
    enlace?.setAttribute('href', `https://wa.me/${numero}?text=${encodeURIComponent(msg)}`);
  }
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => (x.dataset.activo = 'no'));
    t.dataset.activo = 'si';
    panels.forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== t.dataset.cat));
    const primera = document.querySelector(`[data-panel="${t.dataset.cat}"] .opcion`);
    if (primera) {
      document.querySelectorAll(`[data-panel="${t.dataset.cat}"] .opcion`).forEach((o) => o.className = 'opcion rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-white/75 transition hover:border-cielo-400/60');
      primera.className = 'opcion rounded-full border border-cielo-400 bg-cielo-500/20 px-4 py-2 text-sm font-semibold text-white transition';
      cobertura = primera.dataset.opcion ?? cobertura;
    }
    pintarTabs(); actualizar();
  }));
  document.querySelectorAll('.opcion').forEach((o) => o.addEventListener('click', () => {
    const panel = o.closest('.cat-panel');
    panel?.querySelectorAll('.opcion').forEach((x) => x.className = 'opcion rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-white/75 transition hover:border-cielo-400/60');
    o.className = 'opcion rounded-full border border-cielo-400 bg-cielo-500/20 px-4 py-2 text-sm font-semibold text-white transition';
    cobertura = o.dataset.opcion ?? cobertura;
    actualizar();
  }));
  document.querySelectorAll('.prioridad').forEach((p) => p.addEventListener('click', () => {
    document.querySelectorAll('.prioridad').forEach((x) => x.className = 'prioridad rounded-full border border-white/15 px-4 py-2 text-sm text-white/75 transition hover:border-latón-400/60');
    p.className = 'prioridad rounded-full border border-latón-400 bg-latón-500/20 px-4 py-2 text-sm text-white transition';
    prioridad = p.dataset.prioridad ?? prioridad;
    actualizar();
  }));
  pintarTabs(); actualizar();
</script>
