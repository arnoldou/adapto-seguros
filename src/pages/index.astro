---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Coberturas from '../components/Coberturas.astro';
import Proceso from '../components/Proceso.astro';
import Cotizador from '../components/Cotizador.astro';
import Aseguradoras from '../components/Aseguradoras.astro';
import Gestiones from '../components/Gestiones.astro';
import Nosotros from '../components/Nosotros.astro';
